def test_capture_blocked_when_policy_authorization_is_rejected() -> None:
    """Test capture is blocked when policy authorization is rejected."""
    paypal = RecordingPayPalClient()
    client = TestClient(
        create_app(
            policy_verifier=RejectingPolicyVerifier(),
            paypal_client=paypal,
        )
    )
    order = client.post(
        "/payments/create-order",
        json={"amount": "10.00", "currency": "USD"},
    ).json()

    response = client.post(
        f"/payments/capture/{order['id']}",
        json={"authorization_id": "unapproved-reference"},
    )

    assert response.status_code == 403
    assert paypal.captured_order_ids == []
    )
    order = client.post(
        "/payments/create-order",
        json={"amount": "10.00", "currency": "USD"},
    ).json()

    response = client.post(
        f"/payments/capture/{order['id']}",
        json={"authorization_id": "policy-engine-approval"},
    )

    assert response.status_code == 200
    assert "capture_id" in response.json()
    # Order status should reflect capture
    get_response = client.get(f"/payments/{order['id']}")
    assert get_response.json()["status"] in ("captured", "pending_authorization")

    paypal.create_order = failing_create_order
    client = TestClient(create_app(paypal_client=paypal))
    response = client.post(
        "/payments/create-order",
        json={"amount": "10.00", "currency": "USD"},
    )
    assert response.status_code == 502
    assert "PayPal order creation failed" in str(response.json())
    assert created.status_code == 201
    order = created.json()
    assert order["status"] == "pending_authorization"
    assert order["amount"] == "12.50"
    assert order["paypal_order_id"] is not None
    assert order["approval_url"] is not None
